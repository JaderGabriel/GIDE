# -----------------------------------------------------------------------------
# Modelo de variáveis de ambiente — NÃO coloque senhas, APP_KEY ou tokens reais
# aqui. Este arquivo é versionado. Copie para ".env" e preencha os valores
# locais (o ".env" fica fora do Git; é a única fonte de credenciais no disco).
# -----------------------------------------------------------------------------
# composer install / primeiro clone: se não existir ".env", uma cópia é criada
# a partir deste arquivo (veja scripts em composer.json).
# -----------------------------------------------------------------------------

APP_NAME=GIDE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Fuso e idioma (datas humanizadas nas telas; padrão Brasil)
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Alinhe DB_* com o seu PostgreSQL. Para o compose deste repo, veja POSTGRES_*
# em docker-compose.yml (serviço "db").
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seed opcional (não roda automaticamente) para criar/atualizar o user id=1
USER1_NAME=
USER1_USERNAME=
USER1_EMAIL=
USER1_PASSWORD=
USER1_IS_ADMIN=true
USER1_EMAIL_VERIFIED=true

# Integrações (opcional; preferir salvar em /integracoes no banco)
# GESTOR_DEFAULT_BASE_URL=
# GESTOR_DEFAULT_UNITY_ID=
# GESTOR_DEFAULT_ACCESS_PROFILE_ID=
# GESTOR_DEFAULT_ENROLLMENT_SYNC_PATH=
# SMS_DEFAULT_BASE_URL=

# Fila / entregas (tentativas e recuperação via cron — ver README)
# GIDE_DELIVERY_MAX_ATTEMPTS=3
# GIDE_DELIVERY_STALE_MINUTES=15
